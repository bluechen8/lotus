# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  # Configure VM resources
  config.vm.provider "virtualbox" do |vb|
    vb.name = "lotus"
    vb.memory = "32768"
    vb.cpus = 16
  end

  # Sync folders
  config.vm.synced_folder ".", "/home/vagrant/lotus"
  # External software (e.g., vivado) -- mounted read-only
  #config.vm.synced_folder "/scratch/xilinx/", "/scratch/xilinx/", mount_options: ["ro"]

  # Auto-provision the environment with basic tools needed for coding
  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y git build-essential python3 python3-pip scons cmake openjdk-17-jdk pkg-config uuid-dev device-tree-compiler libboost-dev libboost-regex-dev libboost-system-dev ninja-build lld
    # RISCV toolchin deps
    apt-get install -y autoconf automake autotools-dev curl python3 python3-pip python3-tomli libmpc-dev libmpfr-dev libgmp-dev gawk build-essential bison flex texinfo gperf libtool patchutils bc zlib1g-dev libexpat-dev ninja-build git cmake libglib2.0-dev libslirp-dev libncurses-dev
    # Direct python deps
    apt-get install -y python3-networkx python3-pydot python3-sortedcontainers
cd /home/vagrant && wget https://github.com/B-Lang-org/bsc/releases/download/2024.01/bsc-2024.01-ubuntu-24.04.tar.gz && tar xf bsc-2024.01-ubuntu-24.04.tar.gz
    echo 'export PATH=/home/vagrant/bsc-2024.01-ubuntu-24.04/bin:$PATH' >> /home/vagrant/.bashrc
  SHELL
  
  # Forward SSH agent so the VM has the same Git permissions as your host
  #config.ssh.forward_agent = true
  #
  #config.ssh.insert_key = false
end
