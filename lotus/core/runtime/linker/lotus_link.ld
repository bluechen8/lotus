     the same address within the page on the next page up.  */
  . = DATA_SEGMENT_ALIGN (CONSTANT (MAXPAGESIZE), CONSTANT (COMMONPAGESIZE));
  /* Exception handling  */
  .eh_frame       : ONLY_IF_RW { KEEP (*(.eh_frame)) *(.eh_frame.*) } > all :data
  .gnu_extab      : ONLY_IF_RW { *(.gnu_extab) } > all
  .gcc_except_table   : ONLY_IF_RW { *(.gcc_except_table .gcc_except_table.*) } > all
  .exception_ranges   : ONLY_IF_RW { *(.exception_ranges*) } > all
