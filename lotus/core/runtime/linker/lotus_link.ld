      Align after .bss to keep the end symbol aligned even when there are no
      .bss input sections. */
   . = ALIGN(. != 0 ? 32 / 8 : 1);
  } > all
  . = ALIGN(32 / 8);
  . = SEGMENT_START("ldata-segment", .);
  . = ALIGN(32 / 8);
  __BSS_END__ = .;
    __global_pointer = MIN(__SDATA_BEGIN__ + 0x800,
                MAX(__DATA_BEGIN__ + 0x800, __BSS_END__ - 0x800));
  _end = .; PROVIDE (end = .);
