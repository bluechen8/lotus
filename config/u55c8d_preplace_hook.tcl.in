# Constrain the placement of the aurora kernel to close timing. quads use fast
# clocks (404MHz), and without some isolation, 8-device runs have a harder time
# closing timing.
# NOTE: This is the 2 clock regions closest to the transceivers, plus some
# slices of adjacent clock regions since the switch deosn't start till X34.
create_pblock pblock_aurora
resize_pblock pblock_aurora -add {CLOCKREGION_X0Y6:CLOCKREGION_X0Y7}
resize_pblock pblock_aurora -add {SLICE_X31Y360:SLICE_X33Y479}
add_cells_to_pblock pblock_aurora [get_cells -hierarchical -filter "NAME=~level0_i/ulp/aurora_0/*"]

# Place task switch next to aurora
create_pblock pblock_ts
resize_pblock pblock_ts -add @@tokenSwitchPblock
add_cells_to_pblock pblock_ts [get_cells -hierarchical -filter "NAME=~level0_i/ulp/lotus_1/inst/lotus_inst/multiTile/tokenSwitch/*"]

# Fix routed nets near the critical path (helps fastflow)
set criticalNets [get_nets -of [get_timing_paths -slack_lesser_than 0.5 -max_paths 40000] -filter {ROUTE_STATUS==ROUTED}]
puts "Fixing routing for [llength $criticalNets] near-critical nets"
set_property IS_ROUTE_FIXED TRUE $criticalNets

# Auto-generated placement commands
@@placeCmds
